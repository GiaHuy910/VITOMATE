[Unit]
Description=Deploy Agent Worker Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/agent

# Nạp toàn bộ biến môi trường từ file do bootstrap.sh sinh ra
EnvironmentFile=/etc/paas-agent/agent.env
Environment=NODE_ENV=production

ExecStart=/usr/bin/node /opt/agent/src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target